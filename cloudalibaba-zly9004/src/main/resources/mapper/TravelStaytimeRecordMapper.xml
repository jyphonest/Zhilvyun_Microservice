<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atjiao.cloud.mapper.TravelStaytimeRecordMapper">

    <resultMap id="BaseResultMap" type="com.atjiao.cloud.domain.TravelStaytimeRecord">
            <id property="id" column="id" />
            <result property="planId" column="plan_id" />
            <result property="userId" column="user_id" />
            <result property="stayTime" column="stay_time" />
            <result property="createBy" column="create_by" />
            <result property="createTime" column="create_time" />
            <result property="updateBy" column="update_by" />
            <result property="updateTime" column="update_time" />
            <result property="delFlag" column="del_flag" />
    </resultMap>

    <sql id="Base_Column_List">
        id,plan_id,user_id,stay_time,create_by,create_time,
        update_by,update_time,del_flag
    </sql>

    <select id="getAvgStayTimeByPlanId" resultType="java.lang.Long">
        SELECT IFNULL(AVG(stay_time),0) FROM travel_staytime_record WHERE plan_id = #{planId} AND del_flag = 0
    </select>
</mapper>
